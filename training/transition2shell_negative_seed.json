{
  "_note": "Negative and boundary seeds for Transition2Shell. These test where the model's judgement breaks down — false positives (says ok when shell cannot do it), false negatives (says not_capable when shell can), ambiguous intent, and edge case inputs.",
  "seeds": [

    {
      "id": "n01",
      "_category": "boundary — sounds shell-capable but isn't",
      "_scenario": "download_file with HTTP URL — curl not guaranteed",
      "request": {
        "task": "Download the file at https://releases.example.com/v2/app.tar.gz to /tmp/os2ie_sandbox/app.tar.gz",
        "intent": "download_file",
        "inputs": ["url", "destination_path"],
        "outputs": ["return_code"],
        "context": {
          "url": "https://releases.example.com/v2/app.tar.gz",
          "destination_path": "/tmp/os2ie_sandbox/app.tar.gz"
        }
      },
      "expected": {
        "status": "not_capable"
      }
    },

    {
      "id": "n02",
