{
  "_note": "Issues to raise with transition2exec team.",
  "_issues": [
    {
      "issue": 1,
      "title": "Stage 1 emits tool output key names as input values — spurious keys injected into INPUTS",
      "seed": "15",
      "observed": "actual inputs contain 'required_outputs(return_code): true' — output signature key bleeding into Stage 1 INPUTS resolution",
      "root_cause": "Stage 1 prompt has no rule preventing output key names from being used as input values. Model confuses tool output signature with input values when context is sparse.",
      "fix": "Add rule to Stage 1 prompt: 'Do not include tool output key names in INPUTS. INPUTS must only contain values for the tool input signature keys.'"
    },
    {
      "issue": 2,
      "title": "Stage 1 returns status=ok with wrong tool instead of not_mappable when no tool matches"
    }
  ],
  "_root_cause": "_select_best_match falls back to templates[0] when all scores are 0 (no name token overlap). The selected tool has zero output key overlap with the abstract transition's required outputs. No programmatic guard exists to catch this.",
  "_fix": "Add output key overlap guard in _extract_resolved_tools after _select_best_match. If selected tool's output keys have zero intersection with abstract_transition.outputs → return '(none matched)' → stage 2 produces not_mappable.",
  "_safe_to_apply": "All currently-passing seeds produce tools whose output keys match their abstract outputs — the guard will not affect them. Only seeds 06, 07, 08, 15 change: from wrong tool to not_mappable.",
  "_breakdown": [
    { "id": "06", "abstract_tool": "check_python_version",   "abstract_outputs": ["python_version"],    "actual_tool": "exists",                   "tool_outputs": ["is_present"], "problem": "zero output overlap" },
    { "id": "07", "abstract_tool": "count_python_files",     "abstract_outputs": ["python_file_count"], "actual_tool": "list_directory_recursive", "tool_outputs": ["entries"],    "problem": "zero output overlap" },
    { "id": "08", "abstract_tool": "find_files_with_import", "abstract_outputs": ["matching_files"],    "actual_tool": "list_directory_recursive", "tool_outputs": ["entries"],    "problem": "zero output overlap" },
    { "id": "15", "abstract_tool": "run_failing_command",    "abstract_outputs": ["return_code"],       "actual_tool": "exists",                   "tool_outputs": ["is_present"], "problem": "zero output overlap" }
  ],
